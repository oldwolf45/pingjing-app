# 自动归一化换行符
* text=auto eol=lf

# Python 文件
*.py text eol=lf
*.pyi text eol=lf

# 前端文件
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf

# 文档
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# SQL
*.sql text eol=lf

# 二进制文件（不做换行转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
